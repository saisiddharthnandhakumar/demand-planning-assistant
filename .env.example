# Names only. Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (injected by the Vercel integration in production)
DATABASE_URL=

# Auth
CRON_SECRET=
APP_PASSWORD=

# Gemini (event-note parsing and edge briefs only)
GEMINI_API_KEY=
GEMINI_MODEL=

# Zoho Inventory (dry-run is the default; live needs real credentials)
ZOHO_MODE=dry-run
ZOHO_DC=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
